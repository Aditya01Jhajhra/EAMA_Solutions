{
  "date_column": "Order Date",
  "column_mapping": {
    "Product Name": "product",
    "Category": "category",
    "Region": "region",
    "Quantity": "quantity",
    "Sales": "sales",
    "Profit": "profit"
  },
  "metrics": ["sales", "profit", "quantity"],
  "dimensions": ["region", "category"],
  "rolling_window_days": 14,
  "minimum_history_days": 7,
  "z_score_threshold": 3.0,
  "minimum_relative_change": 0.3
}